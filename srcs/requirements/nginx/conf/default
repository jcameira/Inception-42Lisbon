server {
    listen 443 http2 ssl;
    listen [::]:443 http2 ssl;

    server_name  www.DOMAIN_NAME.42.fr DOMAIN_NAME.42.fr;
    
    ssl on;
    ssl_certificate /etc/ssl/certs/jcameira.certs;
    ssl_certificate_key /etc/ssl/private/jcameira.key;

    ssl_protocol TLSv1.3;

    root /var/www/html;

    index index.php;

    location ~ [^/]\.php(/|$) {
        try_files $uri =404;
        fastcgi_pass wordpress:9000;
        include fastcgi_params;
        fastcgi_params SCRIPT_FILENAME$document_root$fast_cgi_script_name;
    }
}